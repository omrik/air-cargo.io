{
  "info": {
    "name": "Airtrack API",
    "description": "Airtrack API. Set the token variable to your API key. Docs: https://docs.air-cargo.io",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Shipments",
      "item": [
        {
          "name": "Track an AWB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"awb\": \"176-12345675\"\n}"
            }
          }
        },
        {
          "name": "Track many AWBs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/batch",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"awbs\": [\n    \"176-12345675\",\n    \"020-12345675\"\n  ]\n}"
            }
          }
        },
        {
          "name": "List shipments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/?page=1&limit=20&status=in_transit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "in_transit"
                }
              ]
            }
          }
        },
        {
          "name": "Get shipment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments",
                "{{shipment_id}}"
              ]
            }
          }
        },
        {
          "name": "Update shipment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments",
                "{{shipment_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"IST\",\n  \"destination\": \"JFK\"\n}"
            }
          }
        },
        {
          "name": "Delete shipment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments",
                "{{shipment_id}}"
              ]
            }
          }
        },
        {
          "name": "Export CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/export?format=csv",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments",
                "export"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                }
              ]
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shipments/stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "shipments",
                "stats"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tracking",
      "item": [
        {
          "name": "Refresh now",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tracking/?shipment_id={{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tracking"
              ],
              "query": [
                {
                  "key": "shipment_id",
                  "value": "{{shipment_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Event history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tracking/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tracking",
                "{{shipment_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Register webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://your-server.example/airtrack\",\n  \"events\": []\n}"
            }
          }
        },
        {
          "name": "List webhooks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks"
              ]
            }
          }
        },
        {
          "name": "Send test delivery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/{{webhook_id}}/test",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "{{webhook_id}}",
                "test"
              ]
            }
          }
        },
        {
          "name": "Delivery logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/{{webhook_id}}/logs?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "{{webhook_id}}",
                "logs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Pause webhook",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/{{webhook_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "{{webhook_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            }
          }
        },
        {
          "name": "Delete webhook",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/webhooks/{{webhook_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "webhooks",
                "{{webhook_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Account and usage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/account/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "account"
              ]
            }
          }
        },
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/account/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "account",
                "api-keys"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"my-integration\"\n}"
            }
          }
        },
        {
          "name": "List API keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/account/api-keys",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "account",
                "api-keys"
              ]
            }
          }
        },
        {
          "name": "Airlines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/carriers/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carriers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Slack",
      "item": [
        {
          "name": "Connect Slack",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integrations/slack",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "slack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://hooks.slack.com/services/...\"\n}"
            }
          }
        },
        {
          "name": "Test Slack",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/integrations/slack/test",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "integrations",
                "slack",
                "test"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://www.air-cargo.io/api"
    },
    {
      "key": "token",
      "value": "your-api-key"
    },
    {
      "key": "shipment_id",
      "value": "your-shipment-uuid"
    },
    {
      "key": "webhook_id",
      "value": "your-webhook-uuid"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
